#!/usr/bin/env bats
# setup_iptables.sh (#146): prints the iptables template with %%SSH_PORT%% replaced, on stdout only,
# and nothing else: wrong arguments exit 1 and a broken template exits 2, both with an empty stdout;
# warnings and hints go to stderr without changing the exit code; it never applies anything (sudo,
# iptables*, netfilter-persistent are recording stubs here and must stay uncalled) and writes nothing.
# ss is a stub written into the sandbox (ATST_TEST_SS_PORTS lists the listening ports); setup fails
# unless the stubs are the commands found first in PATH.

load test_helper

setup() {
  atst_test_setup_sandbox
  repo=$(cd "$BATS_TEST_DIRNAME/.." && pwd)
  S="$repo/setup_iptables.sh"
  B="$ATST_TEST_SANDBOX/bin"
  mkdir -p "$B"
  cat > "$B/ss" <<'EOS'
#!/bin/bash
echo "State  Recv-Q Send-Q Local Address:Port Peer Address:Port"
for p in ${ATST_TEST_SS_PORTS:-}; do
  echo "LISTEN 0      128    0.0.0.0:$p   0.0.0.0:*"
done
EOS
  chmod 755 "$B/ss"
  local c
  for c in sudo iptables iptables-restore ip6tables ip6tables-restore netfilter-persistent; do
    atst_test_stub_script "$B" "$c" record
  done
  PATH="$B:$PATH"
  export PATH
  hash -r
  for c in ss sudo iptables iptables-restore ip6tables ip6tables-restore netfilter-persistent; do
    [ "$(command -v "$c")" = "$B/$c" ]
  done
  # The fixed rule lines of IR-05 (tests/ip_rules_template.bats), so both files check the same lines.
  sed -n '/^expected_rules() {/,/^}/p' "$BATS_TEST_DIRNAME/ip_rules_template.bats" > "$ATST_TEST_SANDBOX/expected.sh"
  [ "$(grep -c 'COMMIT' "$ATST_TEST_SANDBOX/expected.sh")" -eq 2 ]
  . "$ATST_TEST_SANDBOX/expected.sh"
}

teardown() {
  atst_test_teardown_sandbox
}

# stdout only / stderr only of setup_iptables.sh (bats 1.1 run mixes them). $status is the script's.
out() {
  run bash -c '"$@" 2>/dev/null < /dev/null' _ "$@"
}
err() {
  run bash -c '"$@" 2>&1 > /dev/null < /dev/null' _ "$@"
}

# Rule lines (no comments, no blank lines) of what was printed.
rule_lines() {
  printf '%s\n' "$output" | grep -vE '^[[:space:]]*(#|$)'
}

@test "SI-1: --port 10022 prints the v4 rules with the port, a header and the comments kept" {
  export ATST_TEST_SS_PORTS=10022
  out "$S" --port 10022
  [ "$status" -eq 0 ]
  [ "$(printf '%s\n' "$output" | head -n 1)" = '# Generated by setup_iptables.sh --port 10022 from templates/ip_rules_v4.txt' ]
  [ "$(rule_lines | grep -c '%%')" -eq 0 ]
  [ "$(rule_lines | grep -c -- '--dport 10022 ')" -eq 1 ]
  [ "$(printf '%s\n' "$output" | grep -c -- '--dport 22 ')" -eq 0 ]
  diff <(expected_rules v4 | sed 's/--dport 22 /--dport 10022 /') <(rule_lines)
  # The comment lines explaining the placeholder are not replaced.
  [ "$(printf '%s\n' "$output" | grep -E '^#' | grep -c '%%SSH_PORT%%')" -ge 1 ]
}

@test "SI-2: without --port, port 22 with a warning on stderr" {
  export ATST_TEST_SS_PORTS=22
  out "$S"
  [ "$status" -eq 0 ]
  [ "$(rule_lines | grep -c -- '--dport 22 ')" -eq 1 ]
  [[ "$(printf '%s\n' "$output" | head -n 1)" == *'--port 22 '* ]] || false
  [[ "$output" != *'[warn]'* ]] || false
  err "$S"
  [ "$status" -eq 0 ]
  [[ "$output" == *'--port not given'* ]] || false
  [[ "$output" == *'sshd -T'* ]] || false
}

@test "SI-3: --v6 prints the v6 rules, in either order of the options" {
  export ATST_TEST_SS_PORTS=2222
  out "$S" --v6 --port 2222
  [ "$status" -eq 0 ]
  local first="$output"
  out "$S" --port 2222 --v6
  [ "$status" -eq 0 ]
  [ "$output" = "$first" ]
  [[ "$output" == *ipv6-icmp* ]] || false
  [ "$(rule_lines | grep -c -- '--dport 2222 ')" -eq 1 ]
  [ "$(printf '%s\n' "$output" | head -n 1)" = '# Generated by setup_iptables.sh --port 2222 from templates/ip_rules_v6.txt' ]
  diff <(expected_rules v6 | sed 's/--dport 22 /--dport 2222 /') <(rule_lines)
}

@test "SI-4: wrong arguments exit 1 with an empty stdout and the usage on stderr" {
  local -a cases=('--port 0' '--port 65536' '--port 22a' '--port -1' '--port 022' '--port' '--port=22' '--foo' 'extra')
  local c
  for c in "${cases[@]}"; do
    # shellcheck disable=SC2086 # split on purpose: each case is a list of arguments
    out "$S" $c
    [ "$status" -eq 1 ] || { echo "rc $status: $c"; false; }
    [ -z "$output" ] || { echo "stdout: $c"; false; }
    # shellcheck disable=SC2086
    err "$S" $c
    [ "$status" -eq 1 ] || { echo "rc $status: $c"; false; }
    [[ "$output" == *Usage* ]] || { echo "usage: $c"; false; }
  done
  out "$S" --port ''
  [ "$status" -eq 1 ]
  [ -z "$output" ]
  err "$S" --port ''
  [[ "$output" == *Usage* ]] || false
}

@test "SI-5: -h / --help print the usage on stdout and exit 0" {
  local h
  for h in -h --help; do
    out "$S" "$h"
    [ "$status" -eq 0 ]
    [[ "$output" == *setup_iptables.sh* ]] || false
    [[ "$output" == *--port* ]] || false
    [[ "$output" != *'-A INPUT'* ]] || false
  done
}

@test "SI-6: a missing, empty or broken template exits 2 and prints nothing on stdout" {
  local h t
  h=$(atst_test_make_runner_home)
  t="$h/templates/ip_rules_v4.txt"
  cp -p "$t" "$ATST_TEST_SANDBOX/v4.orig"

  # (a) missing
  rm -f "$t"
  out "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]; [ -z "$output" ]
  err "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]; [[ "$output" == *'[error]'* ]] || false

  # (b) empty
  : > "$t"
  out "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]; [ -z "$output" ]
  err "$h/setup_iptables.sh" --port 10022
  [[ "$output" == *'[error]'* ]] || false

  # (c) a broken placeholder on the rule line
  sed '/^[^#]/s/%%SSH_PORT%%/%%SSH_PRT%%/' "$ATST_TEST_SANDBOX/v4.orig" > "$t"
  [ "$(grep -c '%%SSH_PRT%%' "$t")" -eq 1 ]
  out "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]; [ -z "$output" ]
  err "$h/setup_iptables.sh" --port 10022
  [[ "$output" == *'[error]'* ]] || false

  # (d) two rules for the port
  sed '/^[^#].*%%SSH_PORT%%/p' "$ATST_TEST_SANDBOX/v4.orig" > "$t"
  [ "$(grep -vE '^[[:space:]]*#' "$t" | grep -c '%%SSH_PORT%%')" -eq 2 ]
  out "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]; [ -z "$output" ]
  err "$h/setup_iptables.sh" --port 10022
  [[ "$output" == *'[error]'* ]] || false

  # (e) v6 broken like (c)
  t="$h/templates/ip_rules_v6.txt"
  sed -i '/^[^#]/s/%%SSH_PORT%%/%%SSH_PRT%%/' "$t"
  [ "$(grep -c '%%SSH_PRT%%' "$t")" -eq 1 ]
  out "$h/setup_iptables.sh" --v6 --port 10022
  [ "$status" -eq 2 ]; [ -z "$output" ]
  err "$h/setup_iptables.sh" --v6 --port 10022
  [[ "$output" == *'[error]'* ]] || false
}

@test "SI-7: a port nobody listens on is warned about, without changing the exit code" {
  out "$S" --port 10022
  local expected="$output"

  export ATST_TEST_SS_PORTS=22
  err "$S" --port 10022
  [ "$status" -eq 0 ]
  [[ "$output" == *'nothing is listening on TCP port 10022'* ]] || false
  out "$S" --port 10022
  [ "$status" -eq 0 ]
  [ "$output" = "$expected" ]

  export ATST_TEST_SS_PORTS=10022
  err "$S" --port 10022
  [ "$status" -eq 0 ]
  [[ "$output" != *'nothing is listening'* ]] || false

  # 100222 is not 10022
  export ATST_TEST_SS_PORTS=100222
  err "$S" --port 10022
  [ "$status" -eq 0 ]
  [[ "$output" == *'nothing is listening on TCP port 10022'* ]] || false
}

@test "SI-8: without ss the check is skipped silently" {
  export ATST_TEST_SS_PORTS=10022
  out "$S" --port 10022
  local expected="$output"

  local m="$ATST_TEST_SANDBOX/minbin" c
  mkdir -p "$m"
  for c in dirname sed grep; do
    ln -s "$(command -v "$c")" "$m/$c"
  done
  run env PATH="$m" "$BASH" -c '"$BASH" "$1" --port 10022 2>/dev/null < /dev/null' _ "$S"
  [ "$status" -eq 0 ]
  [ "$output" = "$expected" ]
  run env PATH="$m" "$BASH" -c '"$BASH" "$1" --port 10022 2>&1 > /dev/null < /dev/null' _ "$S"
  [ "$status" -eq 0 ]
  [[ "$output" != *'nothing is listening'* ]] || false
  [[ "$output" != *'command not found'* ]] || false
}

@test "SI-9: nothing is written and nothing is applied" {
  local h
  find "$HOME" -mindepth 1 | sort > "$ATST_TEST_SANDBOX/before"
  out "$S" --port 10022
  [ "$status" -eq 0 ]
  out "$S" --v6 --port 10022
  [ "$status" -eq 0 ]
  out "$S" --port 0
  [ "$status" -eq 1 ]
  h=$(atst_test_make_runner_home)
  sed -i '/^[^#]/s/%%SSH_PORT%%/%%SSH_PRT%%/' "$h/templates/ip_rules_v4.txt"
  out "$h/setup_iptables.sh" --port 10022
  [ "$status" -eq 2 ]
  find "$HOME" -mindepth 1 | sort > "$ATST_TEST_SANDBOX/after"
  diff "$ATST_TEST_SANDBOX/before" "$ATST_TEST_SANDBOX/after"
  [ ! -e "$ATST_TEST_SANDBOX/calls.log" ]
  [ ! -e "$HOME/.atst" ]
}

@test "SI-10: same output each time, the last --port wins, port bounds" {
  export ATST_TEST_SS_PORTS="80 1 65535 10022"
  out "$S" --port 10022
  local once="$output"
  out "$S" --port 10022
  [ "$output" = "$once" ]
  out "$S" --port 2222 --port 10022
  [ "$status" -eq 0 ]
  [ "$output" = "$once" ]

  out "$S" --port 80
  [ "$status" -eq 0 ]
  [ "$(rule_lines | grep -c -- '--dport 80 ')" -eq 1 ]
  [ "$(printf '%s\n' "$output" | grep -cE '^#.*--dport (80|443)')" -eq 2 ]
  out "$S" --port 65535
  [ "$status" -eq 0 ]
  [ "$(rule_lines | grep -c -- '--dport 65535 ')" -eq 1 ]
  out "$S" --port 1
  [ "$status" -eq 0 ]
  [ "$(rule_lines | grep -c -- '--dport 1 ')" -eq 1 ]
}

@test "SI-11: stdout holds rules only; the hints are on stderr" {
  export ATST_TEST_SS_PORTS=10022
  out "$S" --port 10022
  [ "$status" -eq 0 ]
  [ "$(printf '%s\n' "$output" | grep -cvE '^(#.*|\*filter|:.*|-A .*|COMMIT|)$')" -eq 0 ]
  err "$S" --port 10022
  [ "$status" -eq 0 ]
  [[ "$output" == *'iptables-restore --test'* ]] || false
  [[ "$output" == *'new ssh connection'* ]] || false
}

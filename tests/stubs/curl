#!/bin/bash
# Test stub for curl (tests/test_helper.bash puts tests/stubs first in PATH).
# Never touches the network and never runs the real curl.
# - Appends its arguments as one line to $ATST_TEST_CURL_LOG. Files given as "-H @<path>"
#   (the Authorization header) are neither opened nor recorded.
# - Prints $ATST_TEST_CURL_BODY, then "\n$ATST_TEST_CURL_HTTP_CODE" (default 200) when -w is given.
# - With $ATST_TEST_CURL_HTTP_CODE_SEQ (space-separated HTTP codes), the n-th call (n = the number of
#   lines in $ATST_TEST_CURL_LOG after appending) prints the n-th code instead; past its end, as above.
# - With $ATST_TEST_CURL_FILE set and a separate "-o <path>" argument (not -o<path> / --output), copies
#   that file to <path> and prints no body (as the real curl does with -o); -w still prints the code.
#   Only when the exit code below is 0; a failed copy makes the stub fail. Unset: nothing changes.
# - Exits with $ATST_TEST_CURL_EXIT (default 0).

# Outside a sandbox: do nothing (and send nothing).
[ -n "${ATST_TEST_CURL_LOG:-}" ] || exit 1

printf '%s\n' "$*" >> "$ATST_TEST_CURL_LOG"

code="${ATST_TEST_CURL_HTTP_CODE:-200}"
if [ -n "${ATST_TEST_CURL_HTTP_CODE_SEQ:-}" ]; then
  read -r -a seq <<< "$ATST_TEST_CURL_HTTP_CODE_SEQ"
  n=$(wc -l < "$ATST_TEST_CURL_LOG")
  if [ "$n" -ge 1 ] && [ "$n" -le "${#seq[@]}" ]; then
    code=${seq[$(( n - 1 ))]}
  fi
fi

rc="${ATST_TEST_CURL_EXIT:-0}"

# -o <path> with ATST_TEST_CURL_FILE: write the file instead of printing the body.
out=""
if [ -n "${ATST_TEST_CURL_FILE:-}" ] && [ "$rc" = 0 ]; then
  prev=""
  for a in "$@"; do
    if [ "$prev" = "-o" ]; then
      out=$a
      break
    fi
    prev=$a
  done
fi
if [ -n "$out" ]; then
  cp -- "$ATST_TEST_CURL_FILE" "$out" || exit 1
else
  printf '%s' "${ATST_TEST_CURL_BODY-}"
fi
for a in "$@"; do
  if [ "$a" = "-w" ]; then
    printf '\n%s' "$code"
    break
  fi
done

exit "$rc"

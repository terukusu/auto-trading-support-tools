# この日数以上前のモニタリングデータは破棄します
ATST_MONITORING_TRUNCATE_BEFORE=3

# チェックが動くタイミングを散らすためのスリープの最大値 (旧形式の crontab (sleep_random.sh) 用)
ATST_CHECK_RANDOM_DELAY_MAX=40

# 過去 n 時間の値動きとスプレッドを、MT ごとの文字要約 (通貨ペア・スプレッドの最小/最大・安値/高値と値幅・最終データの時刻) で通知します。
# ImgBB の API キー (setup_imgbb.sh) があるときはグラフの画像も付けます。0 の場合は通知しない。
ATST_IMAGE_REPORT_TERM=24

# 1 にすると、定期レポートに現在のデスクトップの画像も付けます (ImgBB の API キーがあるときだけ)。
# デスクトップには口座番号・残高・建玉が写り、画像は URL を知っていれば誰でも見られるので、既定は 0 (送らない)。
ATST_IMAGE_REPORT_DESKTOP=0

# 画像を ImgBB に置くときに、消えるまでの秒数 (60〜15552000)。既定は 86400 (24 時間)。
# ImgBB の API キーが無いときは画像を送らない (文字要約だけ)。
ATST_IMGBB_EXPIRATION=86400

# snap.sh (デスクトップを 1 枚撮って ~/.atst/snap/ に残す) が残す画像の枚数 (1〜1000)。古いものから消します。
# 範囲外・数字以外は 10 になります。画像には口座番号・残高が写ります (ファイルは本人だけが読める 600)。
ATST_SNAP_KEEP=10

# 毎朝の「稼働OK」(LINE の今月の送信数つき) を通知します。0 の場合は、パッケージや MetaTrader の更新、
# 送信数の警告があるときだけ通知する (毎日の生存確認の通知も無くなる)。
# LINE の無料プランは月 200 通まで。定期の通知は、この稼働OK が 1 日 1 通、上の定期レポートが 1 日 1 通
# (画像は 4 枚ごとに 1 通。ImgBB のキーがあるとき MT 1 台につきグラフ 2 枚、ATST_IMAGE_REPORT_DESKTOP=1 なら
# デスクトップ 1 枚を足す)。
ATST_DAILY_REPORT=1

# 外形監視のハートビートを送る URL (Healthchecks.io などの ping URL)。空なら送らない。
# VPS が止まったときや、監視が異常を検知している間に外部サービスから通知を受けるためのもの。
# setup_heartbeat.sh で設定するのが標準 (~/.atst/.heartbeat_url に保存)。この行は従来の方法で、
# .heartbeat_url があればそちらが優先。正常なら毎分 ping、監視が異常を検知中 (MT 停止・監視 EA の停止・ティック途絶・取引不能・
# LINE の送信失敗の連続・送信数 8 割超など。相場の異常は含めない) は <URL>/fail に送る。
# 手順は Wiki の「外側からの監視」を参照。値はダブルクォートで囲む。
ATST_HEARTBEAT_URL=""

# LINE の送信失敗 (~/.atst/line_error.log) が直近 60 分以内にこの件数続いたら、ハートビートを /fail にする (1〜999。ログは末尾 1000 行までで 1 件 3 行なので、約 333 件を超える値では /fail にならない)。
ATST_HEARTBEAT_LINE_FAIL_COUNT=3

# この秒数モニタリングデータの更新が無ければ通知します
ATST_MONITORING_THRESHOLD=180

# 監視 EA の CSV の「最後のティックの時刻」(列 2) がこの秒数変わらなければ、ブローカーとの接続断などとして通知します
# (60〜86400。既定 600。範囲外の値は 600 で動きます)。監視 EA を載せるチャートはティックの多い主要通貨ペアにしてください
# (ティックの少ない銘柄では誤検知します)。祝日・早期クローズは抑止しないので、年に数回の誤検知を許容してください。
# ATST_MONITORING_THRESHOLD をこの値以上にすると、MT の再開直後に誤検知することがあるので、これより小さくしてください。
ATST_TICK_THRESHOLD=600

# 1 なら週末 (UTC の金曜 20:00〜月曜 00:00) はティック途絶を判定しません。0 で週末も判定します (週末も配信される銘柄向け)。
ATST_TICK_WEEKEND_SKIP=1

# 監視 EA の CSV の列 9〜12 (ブローカーへの接続・端末の自動売買ボタン・口座の取引許可・口座の EA 取引許可) が
# この秒数ずっと不良なら「取引できない状態」として通知します (60〜86400。既定 300。範囲外の値は 300 で動きます)。
# 取引 EA 自身の「自動売買を許可」(EA のプロパティ) は監視できません。
# 監視 EA を更新して (setup_monitoring_ea.sh) チャートに載せ直すまでは何もしません (doctor.sh の csv の cols が 14 になれば有効)。
ATST_TRADE_READY_THRESHOLD=300

# 1 なら週末 (UTC の金曜 20:00〜月曜 00:00) は取引できない状態を判定しません。0 で週末も判定します。
ATST_TRADE_READY_WEEKEND_SKIP=1

# 通常時にこれ以上のスプレッドになったら異常と判定
ATST_THRESHOLD_SPREAD_UPPER=60

# 異常時にこれ以下のスプレッドになったら復帰と判定
ATST_THRESHOLD_SPREAD_LOWER=30

# 通常時にこれ以上のping(マイクロ秒)になったら異常と判定
ATST_THRESHOLD_PING_UPPER=600000

# 異常時にこれ以下のping(マイクロ秒)になったら復帰と判定
ATST_THRESHOLD_PING_LOWER=300000

# 通常時に10分間高値安値の差がこのpips以上になったら異常と判定
ATST_THRESHOLD_PRICE_UPPER=100

# 異常時に10分間高値安値の差がこのpips以下になったら復帰と判定
ATST_THRESHOLD_PRICE_LOWER=50

# 1 にすると、mtctl.sh start が WINEPREFIX の drive_c/atst/startup_<名前>.ini (Windows から見て C:\atst\startup_<名前>.ini) を作り、
# その ini を付けて MetaTrader を起動し (MT4 は ini のパスを素の引数、MT5 は /config:<パス>)、監視 EA (TerminalMonitoring) を
# 下の通貨ペア・時間足の新しいチャートに起動時に載せます
# (チャートへの手作業の配置が要らなくなります)。<名前> は mtctl.sh start に渡す名前 (ATST_TARGETS の名前) を小文字にしたものです。
# 0 (既定) なら今までどおり手で配置します。この行が無い古い config も 0 と同じです。戻すときは 0 にして mtctl.sh stop / start し直します。
# ini には口座番号・パスワードを書きません。実機での確認状況は README の「監視 EA の自動配置」を見てください。
ATST_AUTO_ATTACH_EA=0

# 自動配置のチャートの通貨ペア。ブローカーの気配値表示 (Market Watch) にある名前に合わせます (例: EURUSD、EURUSDm)。
# 使える文字は英数字と . _ # & ! @ - (32 文字まで)。空や不正な値のときは自動配置せずに起動します。
ATST_AUTO_ATTACH_SYMBOL=EURUSD

# 自動配置のチャートの時間足。M1 M5 M15 M30 H1 H4 D1 W1 MN のどれか。
ATST_AUTO_ATTACH_PERIOD=M5

# 止まったままの異常 (MetaTrader のプロセス停止・監視データの停止・ティック途絶・取引不能・毎分の監視の停止) を、
# 【発生】の通知から何分後に「継続中」として再通知するか (空白区切りの分、昇順、1〜3 個)。
# 1 件の異常につき最大 3 通です。値動き・スプレッド・Ping などの異常は再通知しません。
# "" にすると再通知しません。値が正しくないときと、この行が無いときは 30 120 720 で動きます。
ATST_ALERT_REMIND_MINUTES="30 120 720"

ATST_CONFIG_DIR=$(cd "$(dirname "$BASH_SOURCE")"; pwd)
ATST_ALERT_STATUS_FILE="$ATST_CONFIG_DIR/alert_status"
ATST_LINE_TOKEN=$(f="$ATST_CONFIG_DIR/.line_token"; if [ -e "$f" ]; then cat "$f"; fi)
ATST_LINE_ID=$(f="$ATST_CONFIG_DIR/.line_id"; if [ -e "$f" ]; then cat "$f"; fi)

if [ -z "$WINEPREFIX" ]; then
    WINEPREFIX=$HOME/.wine
fi
if [ -z "$WINEARCH" ]; then
    if [ -d "$WINEPREFIX" ]; then
        WINEARCH=$(cat "$WINEPREFIX"/system.reg | grep -m 1 '#arch' | cut -d '=' -f2)
    else
        WINEARCH=win64
    fi
fi
if [ -z "$WINEDEBUG" ]; then
    WINEDEBUG=-all,err+all
fi
if [ -z "$DISPLAY" ]; then
    DISPLAY=:1
fi

export WINEARCH WINEPREFIX WINEDEBUG DISPLAY

# Wine-Mono/Gecko are disabled by default in common.sh (WINEDLLOVERRIDES="mscoree=;mshtml=").
# To change it, set it here, e.g. WINEDLLOVERRIDES="" to re-enable them.

# 以下の 3 項目は、毎分の監視 (check_all.sh) と run_with_targets.sh 用です。ファイルの末尾に置いてください。
# (書き間違えた行より後は読み込まれないため。末尾なら上の LINE の設定などは読み込み済みで、通知が届きます)

# 毎分の監視 (check_all.sh) で、1 つのチェックに許す最長の秒数 (1〜300)。超えたチェックは打ち切り、LINE に通知します。
ATST_CHECK_TIMEOUT=40

# 毎分の監視 (check_all.sh) で、約定のチェック (check_order.sh) の 1 回目の開始から 2 回目の開始までの秒数 (0〜50)。
ATST_ORDER_CHECK_INTERVAL=30

# 監視する MetaTrader の名前 (インストール先のフォルダ名) の一覧。bash の配列で、名前ごとに ' か " で囲み、
# 空白で区切ります。例: ATST_TARGETS=('Land Prime' 'MetaTrader 5')
# 名前はフォルダ名との前方一致で、大文字小文字は区別しません。
# 毎分の監視 (check_all.sh) と、起動・監視データの整理・画像通知のジョブ (run_with_targets.sh) が使います。
# 未設定・空のときは LINE に通知します (MetaTrader ごとの監視と約定通知、再起動時の自動起動は止まります)。
# 引用符や括弧の閉じ忘れなどで書き間違えると、この行は読み込まれず、LINE に
# 「監視対象が設定されていません」が届きます。そのときはこの行を見直してください。
# 旧形式の crontab の TARGET="('Land Prime')" の ('...') の部分は、そのまま ATST_TARGETS=('Land Prime') と書けます。
ATST_TARGETS=('Land Prime')
